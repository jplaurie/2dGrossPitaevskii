# Finite-background GP scaling used by the initial-condition example.
nx 512
ny 512
aspectRatio 1
timeStep 1.e-5
numberOfSteps 200000
outputIntervalSteps 1000

integrator etd4
dispersionCoefficient -0.5
nonlinearityCoefficient 500
chemicalPotential -500

# These real-time settings are ignored by gp2d_relax, but disabling them makes
# the intended subsequent conservative run explicit.
hyperviscosity 0
hypoviscosity 0
ginzburgLandauDamping 0
forcingEnabled false

threadCount 0
dataDirectory runs/dipole/data
outputDirectory runs/dipole/output
